# Basic runtime configuration (free-by-default)
MODEL_ID=gpt2
USE_ONNX=false
PRELOAD_MODEL=true

# Security / CORS
ALLOW_ORIGINS=*

# Disable any billing integrations by default (true = billing disabled)
DISABLE_BILLING=true

# Redis (optional)
REDIS_URL=redis://redis:6379/0

# MinIO (optional) - local object store for artifacts. Only used if configured.
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio123
MINIO_SECURE=false

# NOTE: This project does NOT include or enable any paid billing provider by default.
# If you add external APIs that charge, set DISABLE_BILLING=false and configure them explicitly.
